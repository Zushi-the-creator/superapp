FROM python:3.11-slim AS builder

WORKDIR /build
COPY backend/requirements-prod.txt .
RUN pip install --no-cache-dir --target=/deps -r requirements-prod.txt gunicorn uvicorn[standard]
RUN python -c "import sys; sys.path.insert(0,'/deps'); import nltk; nltk.download('vader_lexicon', download_dir='/deps/nltk_data'); nltk.download('punkt', download_dir='/deps/nltk_data'); nltk.download('punkt_tab', download_dir='/deps/nltk_data')"

FROM python:3.11-slim

WORKDIR /app
COPY --from=builder /deps /deps
ENV PYTHONPATH=/deps NLTK_DATA=/deps/nltk_data

# Copy only backend code (no data/ DBs — they live on the Fly volume)
COPY backend/*.py .
COPY backend/atlas_v2/ atlas_v2/
COPY backend/.env .env

# Seed files — copied to /app/seed/, then startup copies to /app/data/ if missing
RUN mkdir -p /app/seed /app/data
COPY backend/data/positions.db /app/seed/positions.db
COPY backend/data/exit_strategy_validated.json /app/seed/exit_strategy_validated.json

EXPOSE 8000
CMD ["sh", "-c", "python -c \"import shutil,os; [shutil.copy2(f'/app/seed/{f}', f'/app/data/{f}') for f in os.listdir('/app/seed') if not os.path.exists(f'/app/data/{f}')]; print('[Seed] Done')\" && python -m gunicorn main:app -w 1 -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:8000 --timeout 120"]
