// Merge into ~/.openclaw/openclaw.json (json5). Relevant sections only.
{
  channels: {
    whatsapp: {
      // Lock the bot to the CEO only. With allowlist, no one else can command it.
      dmPolicy: "allowlist",
      allowFrom: ["+9725XXXXXXXX"],   // <-- your WhatsApp number, E.164
      groupPolicy: "allowlist"        // no group access unless explicitly added
    }
  },
  // Heartbeat: 30m ticks during US market hours (Israel time), isolated + light
  // context keeps each tick at ~2-5K tokens. Off-hours coverage comes from the
  // nightly/morning cron jobs, so no 24h heartbeat needed.
  heartbeat: {
    every: "30m",
    activeHours: { start: "16:00", end: "23:30", tz: "Asia/Jerusalem" },
    isolatedSession: true,
    lightContext: true,
    showOk: false
  },
  cron: {
    enabled: true,
    maxConcurrentRuns: 2,          // research + a market job at most; protects the laptop
    retry: { maxAttempts: 3, backoffMs: [30000, 60000, 300000] }
  }
}
